#ifndef SECRETS_H
#define SECRETS_H

// Copy this file to secrets.h and fill in your values.
// secrets.h is gitignored — never commit real credentials.

// WiFi credentials used for initial compile-time fallback.
// After first boot, WiFi is configured via the web dashboard
// and stored in config.json on the SD card.
#define WIFI_SSID   "your-wifi-ssid"
#define WIFI_PASS   "your-wifi-password"

// OpenAI API key (used for AI summaries if provider = "openai").
// Other provider keys (Anthropic, Gemini, ElevenLabs) are set
// at runtime via the web dashboard at http://meetingrecorder.local
#define OPENAI_KEY  "sk-..."

#endif
